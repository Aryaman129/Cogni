# ==============================================================================
# CogniSafe Voice-First Cognitive-Health Monitoring Platform
# Production-Ready Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate sensitive credentials before starting
# the backend service. NEVER commit your actual '.env' file with live keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Authentication & Security Settings
# ------------------------------------------------------------------------------
# SECRET_KEY: Cryptographically secure secret key for JWT session signing.
# Generate a strong key in Python:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_key_in_production

# JWT algorithm (HS256 recommended)
ALGORITHM=HS256

# JWT Access Token expiration in minutes (1440 = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Runtime Environment: 'development' | 'production' | 'test'
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Persistence Settings
# ------------------------------------------------------------------------------
# Default is persistent local SQLite. For production, PostgreSQL is supported:
# e.g., postgresql://cognisafe:password@localhost:5432/cognisafe
DATABASE_URL=sqlite:///./cognisafe.db

# ------------------------------------------------------------------------------
# 3. Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins (no wildcard '*' in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 4. Nebius Token Factory & NVIDIA Nemotron 3.5 Lightning Integration
# ------------------------------------------------------------------------------
# Token Factory API key obtained from Nebius Cloud Console.
# If unset or offline, CogniSafe gracefully degrades to deterministic clinical templates.
NEBIUS_API_KEY=your_token_factory_api_key_here

# Public Nebius Token Factory OpenAI-compatible API base endpoint
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1

# Target LLM model identifier hosted on Nebius Token Factory
NEBIUS_MODEL_ID=nvidia/Nemotron-3_5-Lightning

# Client HTTP request timeout in seconds
NEBIUS_TIMEOUT_SECONDS=30.0

# ------------------------------------------------------------------------------
# 5. Audio Upload Boundaries & Storage
# ------------------------------------------------------------------------------
# Maximum allowed audio upload payload size in bytes (26214400 bytes = 25 MB)
UPLOAD_MAX_SIZE_BYTES=26214400

# Directory for transient audio chunk processing and temporary validation
UPLOAD_DIR=uploads

# ------------------------------------------------------------------------------
# 6. Demo & Sandbox Controls
# ------------------------------------------------------------------------------
# Enable deterministic sandbox demo mode (isolated from clinical user accounts)
ENABLE_SANDBOX_DEMO=0
